# ======================================================================
# Copiar a .env y completar. El .env NO se commitea.
# La app valida todo esto al arrancar: si algo falta o es inseguro, no
# levanta. Es a proposito.
# ======================================================================

# --- Aplicacion -------------------------------------------------------
ENV=dev                      # dev | staging | prod
DEBUG=true
LOG_LEVEL=INFO
ENABLE_DOCS=true             # en prod, false

# --- Control plane ----------------------------------------------------
# Base chica que registra que soderias existen. Es la unica fija.
CONTROL_PLANE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/soderia_control

# --- Bases de soderias ------------------------------------------------
# Cada cliente tiene la suya: soderia_solmar, soderia_lacascada, etc.
# Pueden vivir todas en la misma instancia de Postgres.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_NAME_PREFIX=soderia_

# Cuantos engines mantener abiertos. Ojo:
#   conexiones maximas = TENANT_ENGINE_CACHE_SIZE * (POOL_SIZE + MAX_OVERFLOW)
# Con Postgres default (max_connections=100) no pases de 15 * 10.
# Arriba de 10 clientes activos, meté PgBouncer y bajá el pool a 2.
TENANT_ENGINE_CACHE_SIZE=15
TENANT_POOL_SIZE=5
TENANT_MAX_OVERFLOW=5

# Segundos que se cachea la ficha de un tenant. Si suspendés una sodería
# por falta de pago, tarda esto en cortar el acceso.
TENANT_CACHE_TTL_SECONDS=60

# --- Identificacion de la sodería en cada request ---------------------
# subdomain -> solmar.tuapp.com
# header    -> X-Tenant: solmar
# both      -> intenta subdominio, si no hay usa el header
TENANT_RESOLUTION=both
TENANT_HEADER=X-Tenant
BASE_DOMAIN=localhost

# SOLO DESARROLLO: te deja entrar sin subdominio ni header.
# La config lo rechaza si ENV=prod.
DEFAULT_TENANT=demo

# --- Seguridad --------------------------------------------------------
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimo 32 caracteres. La app no arranca con el valor de ejemplo viejo.
SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Token para los endpoints de alta/baja de soderias. Dejalo vacio para
# deshabilitar esa API.
PLATFORM_ADMIN_TOKEN=

# --- CORS -------------------------------------------------------------
# Lista separada por comas. "*" junto con credentials=true es invalido:
# el navegador lo rechaza. Era el bug del main.py viejo.
CORS_ORIGINS=http://localhost:5173,http://localhost:8500
# Para subdominios por tenant: https://.*\.tuapp\.com
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

# --- Archivos ---------------------------------------------------------
# Cada sodería tiene su carpeta: /data/solmar/comprobantes/pagos/...
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data
STORAGE_PUBLIC_URL_BASE=/archivos

# --- Scheduler --------------------------------------------------------
SCHEDULER_ENABLED=true
# Zona por defecto para soderias nuevas. Cada una guarda la suya.
DEFAULT_TIMEZONE=America/Argentina/Cordoba
SCHEDULER_REPARTOS_HOUR=0
SCHEDULER_REPARTOS_MINUTE=5

# --- Solo para tests --------------------------------------------------
# TEST_TENANT_DSN=postgresql+psycopg2://postgres:postgres@localhost:5432/soderia_test
